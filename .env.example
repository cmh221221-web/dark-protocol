# Copy to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://dark_protocol:change-me@localhost:5432/dark_protocol
# Create a bot with @BotFather; keep the token on the server only.
TELEGRAM_BOT_TOKEN=
JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional OpenAI-compatible provider. Without these values the AI API returns 503 (no fake answers).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_SYSTEM_PROMPT=You are the DARK PROTOCOL assistant. Be helpful, clear, and safe.
CORS_ORIGINS=http://localhost:3000
